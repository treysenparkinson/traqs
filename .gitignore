# Dependencies
node_modules/

# Postgres migration (docs/plans/2026-10-16-postgres-migration.md, D2): production snapshots
# hold emails, encrypted PINs and pay hours, and never leave this machine. local-data is the
# dev server's database cluster.
db/snapshots/
db/local-data/

# Build output
dist/

# Environment variables (secrets)
.env
.env.local
.env.*.local

# Capacitor native projects
android/
ios/

# Editor / OS
.DS_Store
Thumbs.db
*.local

# Xcode per-user state — window layout, open tabs, scroll positions, personal
# scheme ordering. Rewritten on almost every Xcode session, binary, and can't
# merge, so it only ever showed up as noise in commits.
# NOTE: xcshareddata/ is deliberately NOT ignored — it holds Package.resolved
# (SPM version pins) and any schemes shared with the team.
xcuserdata/
*.xcuserstate

# Netlify
.netlify/

# macOS native shell build output
TRAQS MacBook Native/.build/
TRAQS MacBook Native/*.xcodeproj/project.xcworkspace/
TRAQS MacBook Native/*.xcodeproj/xcuserdata/
